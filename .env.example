# Proveedor de embeddings y chat: auto | openai | gemini | local
# En modo 'auto': usa OpenAI (MVP) si OPENAI_API_KEY está definida; si no, Gemini; si no, Ollama local.
AI_EMBEDDING_PROVIDER=auto
AI_CHAT_PROVIDER=auto

# OpenAI Embeddings (MVP recomendado por Requerimientos)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# Google Gemini (alternativa / respaldo activo)
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_CHAT_MODEL=gemini-3.1-flash-lite

# Proveedor Local (Ollama / servidor compatible)
LOCAL_AI_BASE_URL=http://localhost:11434
LOCAL_EMBEDDING_MODEL=nomic-embed-text
LOCAL_CHAT_MODEL=llama3.1

# OCR para páginas escaneadas
OCR_TESSERACT_ENABLED=auto
OCR_TESSERACT_PATH=tesseract
OCR_LANGUAGE=spa+eng
OCR_ENDPOINT_URL=
OCR_VISION_FALLBACK=true

# Seguridad JWT, CORS, Antivirus ClamAV y políticas de VPS
JWT_SECRET=cambia_esta_clave_por_una_secreta_de_al_menos_32_caracteres
JWT_EXPIRATION_MS=86400000
SECURITY_DEMO_SESSION_ENABLED=true
SECURITY_SHUTDOWN_ENABLED=true
SECURITY_CLAMAV_ENABLED=false
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
RAG_CLEANUP_POLICY=DELETE_ON_VERIFY

# PostgreSQL + pgvector
POSTGRES_USER=tactical_user
POSTGRES_PASSWORD=tactical_password
POSTGRES_DB=tacticalplay
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tacticalplay
